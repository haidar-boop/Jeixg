# Copy to `.env` and fill in. NEVER commit your real .env file.

# --- Platform secret (used to encrypt stored credentials) ----------------
# Generate one with: python -c "from quanttrade.core.security import generate_secret_key; print(generate_secret_key())"
QT_SECRET_KEY=

# --- Config overrides (QT_ prefix, __ = nesting) -------------------------
QT_TRADING__MODE=paper
QT_BROKER__NAME=paper
QT_DATA__PROVIDER=synthetic
QT_RISK__MAX_DAILY_LOSS_PCT=0.03
# QT_DATABASE__URL=postgresql+psycopg://quant:quant@localhost:5432/quanttrade

# --- Broker credentials (only set the ones you use) ----------------------
# Alpaca
QT_ALPACA_API_KEY=
QT_ALPACA_API_SECRET=
QT_ALPACA_ACCOUNT_ID=

# Tradier
QT_TRADIER_API_KEY=
QT_TRADIER_ACCOUNT_ID=

# Interactive Brokers (TWS/Gateway runs locally; usually no key needed)
# QT_INTERACTIVE_BROKERS_ACCOUNT_ID=

# Robinhood / Webull (UNOFFICIAL libraries -- use at your own risk)
QT_ROBINHOOD_API_KEY=
QT_ROBINHOOD_API_SECRET=
QT_WEBULL_API_KEY=
QT_WEBULL_API_SECRET=

# --- Text-message (SMS) alerts on every trade, via Twilio ----------------
# Sign up free at https://www.twilio.com/try-twilio, then fill these in.
# Phone numbers must be in +countrycode format, e.g. +15551234567
QT_TWILIO_ACCOUNT_SID=
QT_TWILIO_AUTH_TOKEN=
QT_TWILIO_FROM=
QT_TWILIO_TO=
